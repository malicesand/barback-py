{
  "name": "barback-desktop",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "rimraf dist dist-electron release",
    "dev": "vite",
    "dev:electron": "cross-env NODE_ENV=development vite & wait-on tcp:5173 && electron .",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:renderer && npx electron-builder --mac dir zip dmg --publish never -c.mac.identity=null",
    "pack": "npm run build && electron-builder --dir",
     "dist": "npx electron-builder --mac dir zip dmg --publish never -c.mac.identity=null",
     "release:zip": "xattr -cr 'release/mac/Barback.app' && (cd release/mac && zip -r ../Barback-clean-mac.zip Barback.app)",
    "lint": "eslint ."
  },
  "dependencies": {
    "google-auth-library": "^10.4.0",
    "googleapis": "^161.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-electron": "^0.29.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.maryalice.barback",
    "productName": "Barback Ingest Companion",
    "icon": "icon.png",
    "files": [
      "dist/**",
      "dist-electron/**", 
      "packages/**",
      "!**/*.map",
      "py-project/**",
      "!vendor/**"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "py-project/**",
      "resources/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dir",
        "zip",
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": null,
      "entitlementsInherit": null,
      "gatekeeperAssess": false
    },
    "extraResources": [
      {
        "from": "vendor/python-framework/Python.framework",
        "to": "python-framework/Python.framework"
      },
      {
        "from": "vendor/py-venv",
        "to": "py-venv"
      },
      {
        "from": "vendor/exiftool/mac/exiftool",
        "to": "exiftool/exiftool"
      },
      {
        "from": "resources/",
        "to": "resources"
      },
      {
        "from": "../../py-project/",
        "to": "py-project"
      }
    ]
  }
}
